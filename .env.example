# Environment variables for Doc QA Bot

# ============ App Settings ============
DEBUG=false
LOG_LEVEL=INFO

# ============ API Settings ============
API_HOST=0.0.0.0
API_PORT=8000

# ============ Layer 1: Rule Engine ============
RULE_ENABLE=true
RULE_CONFIDENCE_THRESHOLD=0.95
RULE_DB_PATH=data/rules.json
FAQ_DB_PATH=data/faqs.json

# ============ Layer 2: Small Model ============
SMALL_MODEL_ENABLE=true
EMBEDDING_MODEL_NAME=distilbert-base-uncased
# Alternative: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# Use "cuda" if you have GPU available

RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.6

# ============ Layer 3: LLM ============
LLM_ENABLE=true
LLM_TRIGGER_THRESHOLD=0.65
LLM_PROVIDER=openai
# Options: "openai", "anthropic", "local"
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
OPENAI_API_KEY=sk-your-api-key-here

# ============ Cache Settings ============
CACHE_ENABLE=true
CACHE_BACKEND=memory
# Options: "redis", "memory"
REDIS_URL=redis://localhost:6379/0

# ============ Document Processing ============
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DOC_STORAGE_TYPE=file
DOC_STORAGE_PATH=data/docs

# ============ Feedback ============
FEEDBACK_ENABLE=true
FEEDBACK_DB_PATH=data/feedback.jsonl
ANALYTICS_ENABLE=true
